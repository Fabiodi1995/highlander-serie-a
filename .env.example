# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/highlander

# Email Configuration (One.com SMTP)
SMTP_USER=support@highlandergame.it
SMTP_PASSWORD=your_email_password_here

# Security
SESSION_SECRET=your_very_long_random_string_here

# Application Configuration
# BASE_URL viene rilevato automaticamente in base all'ambiente:
# - Produzione: https://highlandergame.it
# - Sviluppo Replit: URL Replit automatico
# - Locale: http://localhost:5000
# Sovrascrivi solo se necessario:
# BASE_URL=https://highlandergame.it
NODE_ENV=production
PORT=3000

# Optional: Monitoring
SENTRY_DSN=your_sentry_dsn_here